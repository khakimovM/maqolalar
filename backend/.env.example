# App
PORT=
NODE_ENV=development

# Database (docker-compose dagi PostgreSQL)
DATABASE_URL=

# JWT
# PRODUCTION'da albatta kuchli random qiymat qo'ying. Generatsiya:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-o-zgartiring
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Redis
REDIS_HOST=
REDIS_PORT=

# Mail (bo'sh qoldirilsa — OTP kodlar konsolga chiqadi, DEV MODE)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Maqolalar <no-reply@maqolalar.uz>"

# OTP
OTP_TTL=
OTP_MAX_ATTEMPTS=
OTP_BLOCK_TTL=
OTP_COOLDOWN=

# Reset token
RESET_TOKEN_TTL=

# Login lockout (parol bilan kirish — brute-force himoyasi)
# Shuncha noto'g'ri urinishdan keyin email LOGIN_BLOCK_TTL sekundga bloklanadi.
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_TTL=900

# Rate limit (global)
THROTTLE_TTL=
THROTTLE_LIMIT=

# CORS originlar (vergul bilan)
FRONTEND_URLS=http://localhost:3001,http://localhost:3002

# Seed (SuperAdmin)
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# --- Bosqich 0 xavfsizlik sozlamalari ---
# Reverse-proxy (nginx) orqasida bo'lsa 1 qo'ying — haqiqiy IP X-Forwarded-For dan olinadi.
# Proksi yo'q bo'lsa bo'sh qoldiring (IP soxtalashtirilishidan saqlanish uchun).
TRUST_PROXY=
# Request body hajmi limiti (maqola JSON uchun). Standart: 2mb
BODY_LIMIT=2mb

# Bir foydalanuvchi/IP uchun ko'rish takror sanalmaydigan oyna (sekund). Standart 3600 (1 soat)
VIEW_DEDUP_TTL=3600

# Sentry xato kuzatuvi (ixtiyoriy) — bo'sh bo'lsa Sentry o'chiq
SENTRY_DSN=

# --- Retention (kunlik cron, soat 03:00) ---
# Eski yozuvlar shuncha kundan keyin o'chiriladi. 0 = o'sha jadval tozalanmaydi.
# refresh_tokens: muddati o'tganlari avtomatik o'chadi (sozlash shart emas).
VIEW_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=90
EMAILLOG_RETENTION_DAYS=180
